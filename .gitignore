# ── Videos ────────────────────────────────────────────────────────────────────
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv
*.wmv

# ── Images ────────────────────────────────────────────────────────────────────
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.tiff
*.tif
*.heic
*.raw

# ── Model weights ─────────────────────────────────────────────────────────────
*.pth
*.ckpt
*.safetensors
*.bin
*.pkl
*.onnx
*.pt

# ── Large data / output artifacts ─────────────────────────────────────────────
analysis_*/
enhanced_*/
*_tracked.json
*_tracket.json

# ── Credentials / secrets ─────────────────────────────────────────────────────
.env*
!.env*.example
*.pem
*.key
*.p12
*.pfx
credentials.json
*_credentials.*
service_account.json
token.json

# ── Runtime / process files ───────────────────────────────────────────────────
*.log
*.pid
.service.pid
.service-current-log
service.log
# Rotated service logs (service.sh → logs/service-*.log)
logs/
# SAM2 frame extraction in process cwd (tracking_pipeline/sam2_manager.py)
temp_sam2_frames*/
# YOLO/SAM local debug frame dumps (images already covered by *.jpg)
**/debug_frames/

# ── Local test / agent scratch ────────────────────────────────────────────────
test_run_output.txt
test_run_output*.txt
.cursor/

# Baseline smoke-run outputs (re-generated each QA run; scripts/README stay tracked)
working_log/baselines/*/smoke/
working_log/baselines/*/smoke-*/
*.jsonl

# macOS Finder duplicate suffix (e.g. "service 2.log", "driver 3.log")
* 2
* 2.*
* 3
* 3.*
* 4
* 4.*

# ── OS noise ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Python noise ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
venv.dataless-*/

# Local agent tooling
.superpowers/

# Agent scratch paper — in-session memory offload only
working_log/knowledge-base/scratch/*.md

# Agent implementation worktrees
.worktrees/

# Archived local Claude session permissions
.claude.archived/settings.local.json
