# Mac Studio M4 Max dev environment — copy to .env and fill secrets
# ---------------------------------------------------------------
# Secrets (fill in actual values, do not commit):
BJJ_GEMINI_API_KEY=
BJJ_AWS_ACCESS_KEY_ID=
BJJ_AWS_SECRET_ACCESS_KEY=

# Mac-specific overrides (no GPU, 16 GB unified memory)
BJJ_MAX_CONCURRENT_JOBS=1        # 1 job at a time on 16 GB unified memory
BJJ_STANDARD_SEGMENTS=1          # sequential: no GPU parallelism on MPS
BJJ_SEGMENT_MAX_FRAMES=2000      # ≈33s per segment at 60fps; tune to 1500 if OOM

# All other values (prop_stride, gemini knobs, etc.) use defaults.
# gx10 production overrides live in gx10's .env, not here.
# gx10 example: BJJ_STANDARD_SEGMENTS=4 BJJ_SEGMENT_MAX_FRAMES=2000
