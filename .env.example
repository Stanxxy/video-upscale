# Copy to .env and fill in values. Do not commit .env (it contains secrets).

# ── AWS / S3 ──────────────────────────────────────────────────
BJJ_AWS_REGION=us-east-1
BJJ_AWS_ACCESS_KEY_ID=
BJJ_AWS_SECRET_ACCESS_KEY=
# S3 endpoint: leave empty for real AWS, set for LocalStack / MinIO / etc.
BJJ_S3_ENDPOINT_URL=
# Optional LocalStack plane for anonymous trial buckets only.
# BJJ_TRIAL_S3_ENDPOINT_URL=http://127.0.0.1:4566
# BJJ_TRIAL_S3_BUCKETS=trial-video-bucket
# SNS topic ARN (optional, for publishing analysis events)
BJJ_SNS_TOPIC_ARN=
# LocalStack SNS only, and only for LocalStack account ARNs (000000000000).
# A real AWS topic ARN always publishes to AWS even if this is set.
# BJJ_SNS_ENDPOINT_URL=http://127.0.0.1:4566

# ── Gemini (credential) ──────────────────────────────────────
BJJ_GEMINI_API_KEY=

# ── Service ──────────────────────────────────────────────────
BJJ_SERVICE_PORT=8000
BJJ_MAX_CONCURRENT_JOBS=1
BJJ_TEMP_DIR=/tmp/bjj-pipeline
