# Copy to .env and fill in values. Do not commit .env (it contains secrets).

# ── AWS / S3 ──────────────────────────────────────────────────
BJJ_AWS_REGION=us-east-1
BJJ_AWS_ACCESS_KEY_ID=
BJJ_AWS_SECRET_ACCESS_KEY=
# S3 endpoint: leave empty for real AWS, set for LocalStack / MinIO / etc.
BJJ_S3_ENDPOINT_URL=
# SNS topic ARN (optional, for publishing analysis events)
BJJ_SNS_TOPIC_ARN=

# ── Gemini (credential) ──────────────────────────────────────
BJJ_GEMINI_API_KEY=

# ── VLLM (LM Studio / Qwen VL) ──────────────────────────────
BJJ_VLLM_BASE_URL=http://localhost:1234/v1
BJJ_VLLM_MODEL=qwen2.5-vl-7b-instruct
BJJ_VLLM_TIMEOUT_SEC=30.0

# ── Detection ────────────────────────────────────────────────
# Seconds to wait for human detection response via WebSocket
BJJ_DETECTION_TIMEOUT=300.0

# ── Service ──────────────────────────────────────────────────
BJJ_SERVICE_PORT=8000
BJJ_TEMP_DIR=/tmp/bjj-pipeline

# ── Cost / abuse guardrails (single-GB10 public launch) ──────
# G4: at most this many analysis jobs hold the GPU at once. Keep 1 on the
# single GB10 (two pipelines starve each other / OOM). 2..4 only on Spark.
BJJ_MAX_CONCURRENT_JOBS=1
# G4: bounded queue depth. New jobs beyond the running one wait on the GPU up
# to this many; total admitted = concurrent + queued, then HTTP 429. 0 = no queue.
BJJ_MAX_QUEUED_JOBS=1
# G7 kill switch / panic button: true → new-analysis and resume endpoints return
# 503 immediately (stops all GPU/Gemini spend without killing the process).
BJJ_ANALYSIS_DISABLED=false
# G7 daily cap: max NEW analysis jobs started per UTC day; over-cap → 429.
# In-memory counter (resets on process restart).
BJJ_MAX_DAILY_ANALYSES=50

# ── Model ────────────────────────────────────────────────────
BJJ_MODEL_PATH=RealESRGAN_x4plus.pth
